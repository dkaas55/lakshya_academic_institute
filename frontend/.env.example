# Frontend Configuration (.env)

# Backend API URL (use localhost for development, or your Render backend URL in production)
VITE_API_URL=http://localhost:5000

# Institution Branding
# e.g. "St. Xavier's High School" or "Lakshya Academic Institute"
VITE_APP_NAME="Lakshya Academic Institute"

# Short Name used in sidebar headers
# e.g. "St. Xavier's" or "Lakshya Academy"
VITE_APP_SHORT_NAME="Lakshya Academy"

# Tagline shown on login page and fee receipts
VITE_APP_TAGLINE="Excellence in Education"

# Path or URL to the School Logo (can be a local file in /public, e.g. /logo.png, or a Cloudinary / S3 URL)
VITE_APP_LOGO_URL="/logo.png"

# Terminology Mode: "school" or "institute"
# - "school" changes "Batch" to "Class" / "Classes" in dashboards
# - "institute" keeps "Batch" / "Batches"
VITE_APP_MODE="institute"
